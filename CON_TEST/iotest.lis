# File iotest.asm
0000			; ============================================================================== 
0000			; TUSCAN SYSTEM 1 - HARDWARE I/O SIMULATION VERIFICATION TOOL (ONBOARD VDU MODE) 
0000			; Target Assembler: Standalone GNU z80asm 
0000			; Hexadecimal Prefix: $ 
0000			; Memory Footprint: Runs entirely out of EPROM (Requires 0 Bytes of RAM) 
0000			; ============================================================================== 
0000			 
0000			; ------------------------------------------------------------------------------ 
0000			; TUSCAN HARDWARE PORT DEFINITIONS (MATCHING YOUR SIMULATOR ADDITIONS) 
0000			; ------------------------------------------------------------------------------ 
0000			VDU:        EQU     $02             ; Onboard VDU Strobe Output Port 
0000			IOSEL:      EQU     $04             ; Hardware Configuration Jumper Switch Port 
0000			KEYB:       EQU     $05             ; Onboard Keyboard Input Latch Register 
0000			 
0000			; ------------------------------------------------------------------------------ 
0000			; COLD BOOT & ABSOLUTE ENTRY VECTOR TRUMP 
0000			; ------------------------------------------------------------------------------ 
0000			            ORG     $F800           ; Base entry point for your test EPROM 
f800 c3 03 f8		TRUMP:      JP      PON             ; Force absolute jump to break hardware boot mode 
f803			 
f803 f3			PON:        DI                      ; Disable all masks and interrupts 
f804			 
f804			            ; ------------------------------------------------------------------ 
f804			            ; TEST 1: VERIFY PORT $04 (ONBOARD DEVICE JUMPER VALUE) 
f804			            ; ------------------------------------------------------------------ 
f804 db 04		            IN      A,(IOSEL)       ; Pulse your Port $04 handler 
f806 fe 10		            CP      $10             ; Check if it matches the true Onboard VDU mask (0x10) 
f808 28 07		            JR      Z,PORT4_OK      ; Yes! Jump to output success character 
f80a			 
f80a			            ; Fail state: Port $04 did not return $10. Print a '?' indicator token. 
f80a 3e 3f		            LD      A,'?' 
f80c cd 20 f8		            CALL    VDU_OUT 
f80f 18 05		            JR      KEY_ECHO        ; Advance directly to keyboard test 
f811			 
f811			PORT4_OK:   ; Success state: Port $04 matches perfectly. Print a '1' character token. 
f811 3e 31		            LD      A,'1' 
f813 cd 20 f8		            CALL    VDU_OUT 
f816			 
f816			            ; ------------------------------------------------------------------ 
f816			            ; TEST 2: VERIFY PORT $05 (LIVE KEYBOARD MATRIX CACHE LOOP) 
f816			            ; ------------------------------------------------------------------ 
f816 db 05		KEY_ECHO:   IN      A,(KEYB)        ; Pulse your Port $05 keyboard reader 
f818 b7			            OR      A               ; Is input value 00H (No key waiting)? 
f819 28 fb		            JR      Z,KEY_ECHO      ; Yes, spin endlessly until a key hits the cache 
f81b			 
f81b			            ; Success state: A key was pressed! Echo it back out to verify character routing 
f81b cd 20 f8		            CALL    VDU_OUT         ; Display the key character natively on Port $02 
f81e 18 f6		            JR      KEY_ECHO        ; Repeat loop infinitely for continuous typing 
f820			 
f820			; ------------------------------------------------------------------------------ 
f820			; ZERO-STACK NATIVE TUSCAN VDU OUTPUT SUB-ROUTINE 
f820			; ------------------------------------------------------------------------------ 
f820			VDU_OUT:     
f820 4f			            LD      C,A             ; Cache the true ASCII character value inside C 
f821			             
f821 3d			            DEC     A               ; Apply authentic Tuscan hardware pre-shift correction 
f822 e6 7f		            AND     $7F             ; Bring hardware strobe line down to low logic level 
f824 d3 02		            OUT     (VDU),A         ; Pulse Port $02 to fire your simulator display loop 
f826 f6 80		            OR      $80             ; Toggle hardware strobe line high 
f828 d3 02		            OUT     (VDU),A          
f82a e6 7f		            AND     $7F             ; Reset strobe back down to low safety logic level 
f82c d3 02		            OUT     (VDU),A          
f82e			             
f82e 79			            LD      A,C             ; Restore clean ASCII character to accumulator 
f82f c9			            RET                     ; Return to execution line 
f830			 
# End of file iotest.asm
f830
