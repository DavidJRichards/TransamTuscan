0000			ETX:        EQU     $03             ; Line 0011 ; End of Text (^C) 
0000			EOT:        EQU     $04             ; Line 0012 ; End of Transmission (^D) 
0000			BS:         EQU     $08             ; Line 0013 ; Backspace 
0000			TAB:        EQU     $09             ; Line 0014 ; Horizontal Tab 
0000			LF:         EQU     $0A             ; Line 0015 ; Line Feed 
0000			CR:         EQU     $0D             ; Line 0016 ; Carriage Return 
0000			FF:         EQU     $0C             ; Line 0017 ; Form Feed 
0000			XOFF:       EQU     $13             ; Line 0018 ; Transmission Off (^S) 
0000			ESC:        EQU     $1B             ; Line 0019 ; Escape 
0000			CHOME:      EQU     $1C             ; Line 0020 ; Cursor Home 
0000			SPAC:       EQU     $20             ; Line 0021 ; Space character 
0000			DEL:        EQU     $7F             ; Line 0022 ; Delete character 
0000			 
0000			DECMRK:     EQU     156 ;'£'             ; Line 0024 ; Decimal number flag 
0000			PROMPT:     EQU     '*'             ; Line 0025 ; Monitor prompt symbol 
0000			 
0000			JUMP:       EQU     $C3             ; Line 0027 ; Z80 JP instruction opcode 
0000			BRK:        EQU     $FF             ; Line 0028 ; RST 38H opcode for breakpoint 
0000			 
0000			BUFSIZ:     EQU     80              ; Line 0030 ; Length of input buffer 
0000			NBP:        EQU     8               ; Line 0031 ; Number of breakpoints allowed 
0000			DEFLEN:     EQU     127             ; Line 0032 ; Default display func length 
0000			 
0000			MONORG:     EQU     $F800           ; Line 0034 ; Monitor ROM starting address 
